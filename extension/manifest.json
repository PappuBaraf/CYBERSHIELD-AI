{
  "manifest_version": 3,
  "key": "",
  "name": "CyberShield Link Protection",
  "version": "1.0.0",
  "description": "Checks clicked links against the local CyberShield service and blocks locally synced phishing-feed domains.",
  "permissions": ["storage", "alarms", "declarativeNetRequest", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:3001/*", "http://localhost:3001/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "CyberShield Link Protection", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }]
}
